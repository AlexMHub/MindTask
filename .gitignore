# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets — never commit real values (repo is public). .env.example is the
# only tracked exception, and it ships with no value.
.env*
!.env.example

# Editor / local tool directories and files — personal config, not project
# config, so it doesn't belong in a repo other people (or a grader) will read.
.vscode/*
!.vscode/extensions.json
.claude
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel
